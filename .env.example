# Copy to .env locally. For GitHub Actions, add these as repository secrets
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY (same names).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# GitHub project site: https://username.github.io/repo-name/
# Build with: VITE_BASE=/repo-name/ npm run build
# Omit or use / for a custom domain or user site (username.github.io).
VITE_BASE=/
